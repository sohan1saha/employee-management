apiVersion: v1
kind: Secret
metadata:
  name: staffsync-secrets
  namespace: staffsync
type: Opaque
stringData:
  SECRET_KEY: "replace_with_32_byte_high_entropy_secret_in_production"
  DATABASE_URL: "postgresql://staffsync_admin:replace_with_db_password@postgres-rw.staffsync.svc.cluster.local:5432/staffsync_db"
  DATABASE_READ_REPLICA_URL: "postgresql://staffsync_admin:replace_with_db_password@postgres-ro.staffsync.svc.cluster.local:5432/staffsync_db"
  REDIS_URL: "redis://:replace_with_redis_password@redis-master.staffsync.svc.cluster.local:6379/0"
  ENCRYPTION_PASSPHRASE: "replace_with_secure_aes256_passphrase"
