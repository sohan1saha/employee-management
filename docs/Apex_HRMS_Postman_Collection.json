        },
        {
          "name": "Recommend Next Employee ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/employees/next-id?center=Bangalore&doj=2026-08-16", "host": ["{{base_url}}"], "path": ["api", "employees", "next-id"], "query": [{ "key": "center", "value": "Bangalore" }, { "key": "doj", "value": "2026-08-16" }] }
          }
        }
      ]
    },
