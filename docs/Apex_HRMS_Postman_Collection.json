              "mode": "raw",
              "raw": "{\n  \"month_year\": \"2026-08\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/payroll/generate", "host": ["{{base_url}}"], "path": ["api", "payroll", "generate"] }
          }
        },
        {
          "name": "List Payroll Records",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
